# Elasticsearch Configuration
ELASTICSEARCH_PASSWORD=ElasticUTM2025!
ELASTIC_PASSWORD=ElasticUTM2025!

# Security Configuration
JWT_SECRET=UTMStackJWTSecretKey2025MultiTenantProductionDeployment1234567890
